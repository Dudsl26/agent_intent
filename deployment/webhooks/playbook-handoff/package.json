{
  "name": "playbook-handoff-webhook",
  "version": "1.0.0",
  "description": "Webhook for handling transition from lead qualification to Playbook",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "functions-framework --target=playbookHandoff",
    "test": "mocha test/*.test.js",
    "deploy": "gcloud functions deploy playbookHandoff --runtime nodejs18 --trigger-http --allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1"
  }
}
