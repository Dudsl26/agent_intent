{
  "name": "whatsapp-dialogflow-integration",
  "version": "1.0.0",
  "description": "WhatsApp integration with Dialogflow CX via Twilio",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "functions-framework --target=whatsappWebhook",
    "test": "mocha test/*.test.js",
    "deploy": "gcloud functions deploy whatsappWebhook --runtime nodejs18 --trigger-http --allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/dialogflow-cx": "^4.5.0",
    "twilio": "^4.20.0"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1"
  }
}
